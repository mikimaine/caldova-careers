---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import RoleCard from '../components/RoleCard.astro';
import EmptyState from '../components/EmptyState.astro';
import { formatFilterOption, listDepartmentCounts, sortByNewest } from '../lib/jobs';
import type { Job } from '../types/job';

export const prerender = true;

const entries = await getCollection('jobs');
const jobs: Job[] = sortByNewest(
    entries.map((entry) => ({ slug: entry.id, ...entry.data })),
);
const departments = listDepartmentCounts(jobs);
---

<Layout title="Caldova Careers — Open roles">
  <div class="py-8">
    <section class="mb-10">
      <h1 class="text-4xl font-bold text-slate-100 mb-3">Build the future of medicine</h1>
      <p class="text-lg text-slate-400 max-w-2xl">
        Caldova is an AI-native pharmaceutical company. Explore our open roles
        and help us bring better treatments to patients faster.
      </p>
    </section>

    <h2 class="text-2xl font-medium mb-6 text-slate-100">Open roles</h2>

    {jobs.length === 0 ? (
      <EmptyState text="There are no open roles right now. Check back soon." />
    ) : (
      <>
        {/* Filter and count stay hidden until the script below runs, so
            without JavaScript every card shows and no dead control appears. */}
        <div class="mb-4 flex flex-wrap items-center gap-3" data-department-filter-wrapper hidden>
          <label for="department-filter" class="text-sm font-medium text-slate-200">
            Department
          </label>
          <select
            id="department-filter"
            data-testid="department-filter"
            class="rounded-lg bg-slate-900 border border-slate-700 text-slate-100 p-2 focus:ring-2 focus:ring-blue-500 focus:outline-none"
          >
            <option value="" selected>{formatFilterOption('All departments', jobs.length)}</option>
            {departments.map(({ department, count }) => (
              <option value={department}>{formatFilterOption(department, count)}</option>
            ))}
          </select>
        </div>
        <p
          class="mb-6 text-sm text-slate-400"
          data-testid="roles-count"
          aria-live="polite"
          hidden
        ></p>
        <div
          class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
          data-testid="roles-grid"
        >
          {jobs.map((job) => <RoleCard job={job} />)}
        </div>
        <script is:inline>
          (() => {
            const wrapper = document.querySelector('[data-department-filter-wrapper]');
            const select = document.querySelector('[data-testid="department-filter"]');
            const count = document.querySelector('[data-testid="roles-count"]');
            const cards = Array.from(document.querySelectorAll('[data-testid="role-card"]'));
            if (!wrapper || !select || !count) return;

            // e.g. "14 open roles", "1 open role in Sales", "2 open roles in Finance".
            const formatCount = (visible, department) => {
              const noun = visible === 1 ? 'open role' : 'open roles';
              return department === null
                ? `${visible} ${noun}`
                : `${visible} ${noun} in ${department}`;
            };

            // The only writer of the select, the cards and the count line.
            // `null` means All departments.
            const apply = (department) => {
              let visible = 0;
              for (const card of cards) {
                const show = department === null || card.dataset.department === department;
                card.hidden = !show;
                if (show) visible += 1;
              }
              select.value = department === null ? '' : department;
              count.textContent = formatCount(visible, department);
            };

            // The rendered Departments; an address value must match one exactly.
            const known = new Set(
              Array.from(select.options, (option) => option.value).filter((value) => value !== ''),
            );

            // The address is the source of truth (AD-3): a missing, empty,
            // unknown or differently-cased value means All departments.
            const readDepartment = () => {
              const value = new URLSearchParams(location.search).get('department');
              return value !== null && known.has(value) ? value : null;
            };

            // Replace (never push) the history entry so choosing adds no entries.
            const writeDepartment = (department) => {
              const params = new URLSearchParams(location.search);
              if (department === null) {
                params.delete('department');
              } else {
                params.set('department', department);
              }
              const query = params.toString();
              history.replaceState(
                history.state,
                '',
                `${location.pathname}${query ? `?${query}` : ''}${location.hash}`,
              );
            };

            wrapper.hidden = false;
            count.hidden = false;
            apply(readDepartment());

            select.addEventListener('change', () => {
              const department = select.value === '' ? null : select.value;
              writeDepartment(department);
              apply(department);
            });

            // A back/forward-cache restore may bring back a select value that
            // disagrees with the address; re-apply from the address.
            window.addEventListener('pageshow', (event) => {
              if (event.persisted) apply(readDepartment());
            });
          })();
        </script>
      </>
    )}
  </div>
</Layout>
